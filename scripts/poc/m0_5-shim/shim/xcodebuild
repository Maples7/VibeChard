#!/usr/bin/env bash
# vch shim — fake xcodebuild that auto-injects per-worktree isolation flags
# then execs the real xcodebuild.
#
# Activated by prepending the directory containing this file to PATH.
# Reads three optional env vars (set by `vch exec` / `vch build` in production):
#   VCH_DERIVED_DATA_PATH         → -derivedDataPath
#   VCH_SPM_CLONE_DIR             → -clonedSourcePackagesDirPath
#   VCH_RESULT_BUNDLE_PATH        → -resultBundlePath
#
# Behavior:
#   • If the env var is unset, the corresponding flag is NOT injected.
#   • If the user already passed the flag explicitly, the user's value wins
#     and we do NOT double-inject.
#   • The real xcodebuild is resolved via /usr/bin/xcrun -f xcodebuild,
#     which bypasses PATH and avoids recursion into ourselves.
#   • All other args are passed through unchanged.
#   • exit code is the real xcodebuild's exit code (we exec, not fork).

set -euo pipefail

# Resolve real xcodebuild without going through PATH.
real_xcodebuild="$(/usr/bin/xcrun -f xcodebuild 2>/dev/null || true)"
if [ -z "$real_xcodebuild" ] || [ ! -x "$real_xcodebuild" ]; then
  echo "vch-shim: failed to locate real xcodebuild via /usr/bin/xcrun -f" >&2
  exit 127
fi

# Defensive: if xcrun for any reason returned our own path, abort to prevent
# infinite recursion.
self_path="${BASH_SOURCE[0]}"
case "$real_xcodebuild" in
  "$self_path"|"$(cd "$(dirname "$self_path")" && pwd)/xcodebuild")
    echo "vch-shim: refusing to exec self ($real_xcodebuild)" >&2
    exit 127
    ;;
esac

# Detect which isolation flags the user already provided so we don't override.
has_derived=0
has_spm=0
has_result=0
for arg in "$@"; do
  case "$arg" in
    -derivedDataPath)              has_derived=1 ;;
    -clonedSourcePackagesDirPath)  has_spm=1 ;;
    -resultBundlePath)             has_result=1 ;;
  esac
done

# Build the augmented arg list.
injected=()
if [ "$has_derived" -eq 0 ] && [ -n "${VCH_DERIVED_DATA_PATH:-}" ]; then
  mkdir -p "$VCH_DERIVED_DATA_PATH"
  injected+=(-derivedDataPath "$VCH_DERIVED_DATA_PATH")
fi
if [ "$has_spm" -eq 0 ] && [ -n "${VCH_SPM_CLONE_DIR:-}" ]; then
  mkdir -p "$VCH_SPM_CLONE_DIR"
  injected+=(-clonedSourcePackagesDirPath "$VCH_SPM_CLONE_DIR")
fi
if [ "$has_result" -eq 0 ] && [ -n "${VCH_RESULT_BUNDLE_PATH:-}" ]; then
  # -resultBundlePath wants a path that does NOT yet exist; do not mkdir.
  parent="$(dirname "$VCH_RESULT_BUNDLE_PATH")"
  mkdir -p "$parent"
  injected+=(-resultBundlePath "$VCH_RESULT_BUNDLE_PATH")
fi

# Optional verbose logging for the PoC.
if [ -n "${VCH_SHIM_DEBUG:-}" ]; then
  printf 'vch-shim: real=%s\n' "$real_xcodebuild" >&2
  printf 'vch-shim: injected=%s\n' "${injected[*]:-<none>}" >&2
  printf 'vch-shim: user-args=%s\n' "$*" >&2
fi

exec "$real_xcodebuild" "${injected[@]}" "$@"
